APP_PORT=5000
# Comma-separated, exact origins of the frontend(s). Used by CORS AND by the Origin/Referer check on state-changing requests.
# Required in production; never "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_DOMAIN=localhost
# true only behind a reverse proxy you control (it makes X-Forwarded-For - the rate-limit key - trusted).
TRUST_PROXY=false
BODY_LIMIT_BYTES=102400

######################################
############### DATABASE #############
DB_NAME=app_db
DB_USERNAME=app
DB_PASSWORD=app123456
DB_HOST=localhost
DB_PORT=5432
# true: the API and the worker apply pending migrations at boot (one at a time, under a Postgres advisory lock).
# false: run `npm run migration:run` yourself (for example as a deploy step).
DB_AUTO_MIGRATE=true
DB_LOGGING=false

######################################
############### JOBS / ENGINES #######
# Engines that run in this deployment: comma-separated ids from src/engines/index.ts, "*" for all of them,
# "none" for no engine. REQUIRED in production, so merged-but-unreviewed engine code never runs by accident.
ENGINES_ENABLED=*
# Worker only: run just these engines in this process (default: every enabled engine). Give a heavy engine
# its own worker with e.g. WORKER_ENGINES=audit.
WORKER_ENGINES=
# Optional tunables: how often the worker polls (ms), how long a running job's lease lasts before another
# worker may take it over (s), and how long finished jobs are kept (days).
# WORKER_POLL_INTERVAL_MS=1000
# JOB_LEASE_SECONDS=60
# JOB_RETENTION_DAYS=30
# On SIGTERM the worker waits this long (s) for running jobs before handing them back to the queue.
# WORKER_SHUTDOWN_GRACE_SECONDS=30

######################################
############### AUTH #################
# Dev-only placeholders. Each secret must be 32+ characters and the three must differ
# (production: generate with `openssl rand -base64 48` and inject from the secret store).
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-9876543210
# Keys the HMAC that protects stored OTP codes.
OTP_HMAC_SECRET=dev-only-otp-hmac-secret-change-me-abcdef0123
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_SECONDS=604800
# bcrypt cost, minimum 12.
PASSWORD_SALT_ROUNDS=12

# The one super administrator, synced from these two values on every boot. The password must satisfy the
# password policy (8+ chars, upper, lower, digit, special). Anyone else holding SUPERADMIN is demoted.
SUPERADMIN_EMAIL=superadmin@system.local
SUPERADMIN_PASSWORD=Change-Me-Dev-1!
# true: verified users wait for a super admin to approve them. false: verifying the email activates the account.
REQUIRE_APPROVAL=true

# Failed logins before the account is locked, and for how long.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Email OTP codes (verification + password reset).
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HOURLY_CAP=5

# Sessions. Oldest is evicted past the cap. 0 disables the idle timeout. The absolute lifetime is a hard cap
# however often the session refreshes.
MAX_SESSIONS_PER_USER=10
SESSION_IDLE_TIMEOUT_SECONDS=0
SESSION_ABSOLUTE_LIFETIME_SECONDS=2592000
REFRESH_GRACE_SECONDS=10
# register / resend / forgot-password never answer faster than this, so existing and unknown emails look alike.
ANTI_ENUMERATION_MIN_RESPONSE_MS=400
AUTH_EVENT_RETENTION_DAYS=90

######################################
############### RATE LIMITS ##########
# Per IP: <LIMIT> requests per <TTL_SECONDS>. Buckets: GLOBAL (untagged routes), REGISTER, LOGIN,
# RESEND (resend-verification + forgot-password), VERIFY_OTP (verify-email + reset-password), REFRESH,
# SENSITIVE (change-password). Counters live in memory, per instance.
RATE_LIMIT_GLOBAL_LIMIT=120
RATE_LIMIT_GLOBAL_TTL_SECONDS=60
RATE_LIMIT_REGISTER_LIMIT=10
RATE_LIMIT_REGISTER_TTL_SECONDS=3600
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_TTL_SECONDS=60
RATE_LIMIT_RESEND_LIMIT=5
RATE_LIMIT_RESEND_TTL_SECONDS=600
RATE_LIMIT_VERIFY_OTP_LIMIT=10
RATE_LIMIT_VERIFY_OTP_TTL_SECONDS=600
RATE_LIMIT_REFRESH_LIMIT=30
RATE_LIMIT_REFRESH_TTL_SECONDS=60
RATE_LIMIT_SENSITIVE_LIMIT=10
RATE_LIMIT_SENSITIVE_TTL_SECONDS=600

######################################
############### SWAGGER URLS #########
SWAGGER_URLS=http://localhost:5000
SWAGGER_ENABLED=true

######################################
############### Redis ################
# REDIS_ENABLED=true connects the Redis client (cache + health probe); false = no connection, health reports 'disabled'.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123456

#######################################
##########  STRINGIFY LOGS   ##########
STRINGIFY_LOGS_Enabled=false

######################################
############### EMAIL ################
# EMAIL_ENABLED=false -> emails (including OTP codes) go to the app log: development only, production REFUSES to boot.
# Production: EMAIL_ENABLED=true and EMAIL_HOST/PORT/USER/PASS/FROM from the deployment's secret store.
# EMAIL_SECURE=true for implicit TLS (465); EMAIL_REQUIRE_TLS=true to enforce STARTTLS (587).
EMAIL_ENABLED=false
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@app.local
EMAIL_REPLY_TO=
EMAIL_REQUIRE_TLS=false
